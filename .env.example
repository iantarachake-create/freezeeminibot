PORT=8000
PREFIX=.
OWNER_NUMBER=254700000000
WORK_TYPE=public            # public | private
BOT_NAME=freezer minibot

# --- Session storage ---
# Leave MONGODB_URI empty => sessions saved on disk in ./sessions (needs a persistent volume/disk).
# Set it (your OWN Mongo, e.g. Atlas free tier) => sessions survive redeploys on Heroku/Render/Koyeb etc.
MONGODB_URI=

# --- Capacity / safety ---
MAX_SESSIONS=50            # ~30-60MB RAM per session
ADMIN_KEY=change-me         # protects /api/admin/* (list, disconnect)

# --- Keep-alive (free hosts that sleep). Public URL of this app: ---
APP_URL=
