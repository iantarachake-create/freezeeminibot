# ===== FREEZER MINI BOT SETTINGS =====
# Ready to deploy: upload the project to a PRIVATE GitHub repo.
# This file contains secrets (database password, encryption key). Never put it in a public repo.

# Supabase "Session pooler" connection string
DATABASE_URL=postgresql://postgres.lwcjbdnksfxkpnvckkes:taracha2004%3F@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Tables are created with this prefix, so this bot can share the SAME Supabase project as your other
# bots without their data mixing. Do not change it after users have linked.
DB_TABLE_PREFIX=fz_

# Encrypts stored WhatsApp credentials in the database. Do NOT change it after users have linked,
# or their sessions become unreadable. Keep a copy somewhere safe. (Different from your other bots' keys.)
ENCRYPTION_KEY=d5bb3dfcbf75135d2a9d8a5a798a280f6867d1fe8c50920b37a03862a4588ac8

DB_POOL_MAX=5
MAX_SESSIONS=50
RESTORE_STAGGER_MS=2500
RESTORE_BATCH=5

# ---- Defaults for every newly linked account (same as the original bot) ----
# Each user can change their own with /update-config (OTP sent to their own WhatsApp).
PREFIX=.
WORK_TYPE=public
AUTO_VIEW_STATUS=true
AUTO_LIKE_STATUS=true
AUTO_STATUS_REPLY=false
READ_MESSAGE=false
AUTO_TYPING=false
AUTO_RECORDING=false
ANTI_CALL=false

# Optional: WhatsApp channel(s) every linked account follows once (comma-separated JIDs). Empty = off.
# The original bot did not follow any channel.
FOLLOW_CHANNELS=

# Optional: password for the admin-only endpoints (/active, /status, /disconnect, /connect-all)
# ADMIN_PASSWORD=
